pipeline {
              agent any

  	  stages {
       		 stage('build') {
           			 steps {
                				Echo 'Building'

                                                 sh 'whoami'
       		     }
       			 }


	  stage('Test') {
        		    steps {
           		         echo 'Testing'
                                          sh 'hostname'
         	   }
        	}

 	  stage('Deploy') {
        		    steps {
 		               echo 'Deploy'
                                          sh 'ls -la'
         		   }
        			}

		} }
